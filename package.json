{
  "name": "sales-to-implementation-handoff-validator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:fixtures": "node --conditions=react-server --import tsx scripts/validate-fixtures.ts",
    "test": "vitest run",
